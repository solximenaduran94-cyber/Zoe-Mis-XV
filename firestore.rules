rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == "jimenagloop.ad@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isValidGuestMessage(data) {
      return data.keys().hasAll(['authorName', 'message', 'createdAt']) &&
        data.keys().hasOnly(['authorName', 'message', 'song', 'createdAt']) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 500 &&
        (!('song' in data) || (data.song is string && data.song.size() >= 0 && data.song.size() <= 120)) &&
        data.createdAt is timestamp && data.createdAt == request.time;
    }

    match /messages/{messageId} {
      allow get, list: if true;
      allow create: if isValidId(messageId) && isValidGuestMessage(incoming());
      allow update: if false;
      allow delete: if isAdmin() && isValidId(messageId);
    }
  }
}
